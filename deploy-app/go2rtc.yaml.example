# MG-VMS — Configuration go2rtc 1.9.9+
# Doc : https://github.com/AlexxIT/go2rtc

# ─── API HTTP (UI + REST + WebSocket) ──────────────────────────────────
api:
  listen: ":1984"

# ─── RTSP (clients internes : recorder, frame_source IA, VLC…) ─────────
# `default_query` = filtre de codecs par défaut pour les CLIENTS qui consomment
# rtsp://go2rtc:8554/cam_X. ⚠ NE PAS mettre "mp4" ici : cela exclut les pistes
# audio PCM (pcm_alaw/pcm_mulaw, très courantes sur caméras IP) des enregistrements.
# NOTE : ce paramètre ne concerne PAS les connexions sortantes vers les caméras —
# go2rtc utilise déjà TCP par défaut pour ses sources RTSP.
rtsp:
  listen: ":8554"
  default_query: "video&audio"

# ─── WebRTC ────────────────────────────────────────────────────────────
# Non utilisé par le chemin de preview P0 (MJPEG via /api/frame.jpeg et
# /api/streams). À configurer seulement si vous activez un jour le WebRTC
# natif de go2rtc : remplacez l'IP ci-dessous par l'IP LAN réelle du serveur.
webrtc:
  listen: ":8555"
  candidates:
    - 192.168.1.21:8555      # ← à adapter : IP LAN de votre serveur
    # - stun:8555            # décommenter si accès WAN via NAT nécessaire
  ice_servers:
    - urls: [stun:stun.l.google.com:19302]

# ─── FFmpeg (transcoding interne Go2RTC) ────────────────────────────────
# Sans override du template `rtsp`, Go2RTC lance ffmpeg avec les paramètres
# par défaut qui ne forcent PAS `rtsp_transport tcp`. Sur des LAN imparfaits
# ou en présence de firewalls UDP-restrictifs, ffmpeg reçoit des paquets
# corrompus → artefacts "neige" à l'écran et dans les enregistrements.
#
# Les flags ci-dessous :
#   -fflags nobuffer      → n'attend pas de buffer avant démarrage (latence ↓)
#   -flags low_delay      → coupe la reordering queue du décodeur
#   -rtsp_transport tcp   → force TCP (aucun paquet perdu)
#   -rtsp_flags prefer_tcp → double garde en cas de redirection
#   -timeout 15000000     → timeout socket 15s (µs) — évite les hangs
#   -analyzeduration 1M   → probe rapide du stream (2s → 1s)
#   -probesize 1M         → probe plus rapide (par défaut 5MB)
ffmpeg:
  bin: ffmpeg
  rtsp: "-fflags nobuffer -flags low_delay -rtsp_transport tcp -rtsp_flags prefer_tcp -timeout 15000000 -analyzeduration 1000000 -probesize 1000000 -i {input}"

log:
  level: info

# ─── Streams ───────────────────────────────────────────────────────────
# Les caméras réelles sont AJOUTÉES DYNAMIQUEMENT par MG-VMS via l'API
# `PUT /api/streams` (voir backend/streaming.py::register_camera_stream).
# Ne PAS déclarer manuellement les caméras réelles ici : elles seraient
# écrasées par le backend au boot.
#
# Ce fichier ne déclare QUE les caméras de démonstration (mires/vidéos loop).
streams:
  # Caméra démo 1 : mire H.264 réelle générée localement (validation du pipeline)
  cam_demo-cam-001:
    - exec:ffmpeg -re -f lavfi -i testsrc2=size=1280x720:rate=15 -c:v libx264 -preset ultrafast -tune zerolatency -pix_fmt yuv420p -g 30 -f rtsp {output}
  cam_demo-cam-001_hd:
    - ffmpeg:cam_demo-cam-001#video=mjpeg
  cam_demo-cam-001_sd:
    - ffmpeg:cam_demo-cam-001#video=mjpeg#width=640

  # Caméra démo 2 : scène de rue réelle en boucle → IA YOLO + LAPI
  cam_demo-cam-002:
    - exec:ffmpeg -stream_loop -1 -re -i /demo-media/street-demo.mp4 -c:v libx264 -preset ultrafast -tune zerolatency -pix_fmt yuv420p -g 30 -an -f rtsp {output}
  cam_demo-cam-002_hd:
    - ffmpeg:cam_demo-cam-002#video=mjpeg
  cam_demo-cam-002_sd:
    - ffmpeg:cam_demo-cam-002#video=mjpeg#width=640
