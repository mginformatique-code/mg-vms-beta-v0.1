# ═══════════════════════════════════════════════════════════════════════════
# MG-VMS — Déploiement Docker production (v1.0-rc4)
# ═══════════════════════════════════════════════════════════════════════════
# Copier ce fichier en `.env` : cp .env.example .env
# Puis adapter les valeurs à VOTRE serveur (surtout IP LAN + secrets).
# NE JAMAIS committer le .env réel (secrets).

# ─── Persistance disque (bind mounts host) ───────────────────────────────
# Ces chemins DOIVENT exister sur le host AVANT le premier `docker compose up` :
#   sudo mkdir -p /mnt/storage/mongodb \
#                 /mnt/storage/video-datastore/recordings \
#                 /mnt/storage/models /mnt/storage/crops \
#                 /mnt/storage/logs /mnt/storage/certs /mnt/storage/backups
# Disques dédiés recommandés (MongoDB → SSD, enregistrements → HDD).
MONGO_DATA_PATH=/mnt/storage/mongodb
RECORDINGS_PATH=/mnt/storage/video-datastore/recordings
MODELS_PATH=/mnt/storage/models
CROPS_PATH=/mnt/storage/crops
LOGS_PATH=/mnt/storage/logs
CERTS_PATH=/mnt/storage/certs
BACKUPS_PATH=/mnt/storage/backups

# ─── Base MongoDB ────────────────────────────────────────────────────────
MONGO_URL=mongodb://mongo:27017
DB_NAME=mgvms

# ─── Réseau / CORS ───────────────────────────────────────────────────────
# IP LAN du serveur MG-VMS (adaptez à votre setup).
# TOUS les endpoints (frontend, WebRTC, API) doivent utiliser cette IP.
CORS_ORIGINS=http://192.168.1.21:3000

# URL du backend vue par le NAVIGATEUR (figée au build du frontend).
REACT_APP_BACKEND_URL=http://192.168.1.21:8001

# ─── Secrets — À CHANGER en production ───────────────────────────────────
# Générer : openssl rand -hex 32
JWT_SECRET=please_change_this_secret_in_production

# ─── Compte administrateur initial (créé au premier démarrage) ──────────
ADMIN_EMAIL=admin@mg-vms.com
ADMIN_PASSWORD=Admin@2026

# ─── go2rtc ──────────────────────────────────────────────────────────────
# URL interne (docker network) — laissez la valeur par défaut sauf si vous
# passez en `network_mode: host`, auquel cas utilisez localhost:1984.
GO2RTC_URL=http://go2rtc:1984
GO2RTC_RTSP=rtsp://go2rtc:8554

# ─── GPU NVIDIA ──────────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# ─── IA / Accélération ──────────────────────────────────────────────────
# Mode d'accélération matérielle du décodage vidéo pour l'IA :
#   auto : détecte hevc_cuvid/h264_cuvid dans ffmpeg → GPU si dispo, sinon CPU
#   cuda : force GPU (crash si NVDEC indispo — utilisez pour debug)
#   none : force CPU (utile pour tests / GPU non-NVIDIA)
MGVMS_AI_HW_ACCEL=auto

# Résolution des frames envoyées à YOLO (défaut 1280×720 = bon compromis
# vitesse/précision pour YOLOv11s sur RTX A2000). Baissez à 960×540 si
# vous avez beaucoup de caméras et une charge GPU élevée.
MGVMS_AI_FRAME_WIDTH=1280
MGVMS_AI_FRAME_HEIGHT=720

# v3.1.3 · Cadence de sortie du décodage IA (fps). La boucle IA ne consomme
# qu'à ~6,7 fps (AI_INTERVAL_SECONDS=0.15 par défaut) — décoder/télécharger
# plus vite que ça gaspille du transfert GPU→CPU pour des frames jamais
# lues (mesuré : >70% des frames en trop à la cadence caméra ~20-25 fps).
# Réduire ce chiffre allège encore le CPU ; ne pas descendre sous ~2x
# AI_INTERVAL pour éviter des frames trop périmées au moment de l'analyse.
MGVMS_AI_OUTPUT_FPS=10

# Transcoding MJPEG go2rtc via GPU (nécessite runtime nvidia sur go2rtc).
# Laisser à 0 par défaut : go2rtc n'a pas de GPU passthrough dans cette compose.
GO2RTC_FFMPEG_CUDA=0

# ─── Ports frontend (Nginx du conteneur frontend) ────────────────────────
FRONTEND_HTTP_PORT=3000
FRONTEND_HTTPS_PORT=3443

# ─── TLS / HTTPS (OPTIONNEL — non bloquant) ──────────────────────────────
# Requis UNIQUEMENT avec l'overlay Let's Encrypt :
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# MGVMS_DOMAIN=vms.exemple.com
# MGVMS_HOSTNAME=mg-vms.local
# HTTPS_FORCE=false

# ─── Divers ──────────────────────────────────────────────────────────────
TZ=Europe/Paris
