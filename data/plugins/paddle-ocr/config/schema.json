{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaddleOCR (local)",
  "type": "object",
  "properties": {
    "lang": {"type": "string", "default": "en", "title": "Langue", "enum": ["en", "fr", "german", "spanish", "italian", "portuguese"]},
    "use_gpu": {"type": "boolean", "default": false, "title": "Utiliser GPU (si dispo)"},
    "min_confidence": {"type": "number", "default": 0.5, "minimum": 0.0, "maximum": 1.0}
  }
}
