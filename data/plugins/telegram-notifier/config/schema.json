{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telegram Notifier",
  "type": "object",
  "required": ["bot_token", "chat_id"],
  "properties": {
    "bot_token": {"type": "string", "title": "Bot Token", "description": "Créer un bot via @BotFather sur Telegram", "format": "password"},
    "chat_id": {"type": "string", "title": "Chat ID", "description": "ID du chat/groupe destination (ex: -1001234567890)"},
    "event_types": {
      "type": "array",
      "items": {"type": "string"},
      "default": ["alert.critical", "plate.blacklist", "event.detected"],
      "title": "Types d'événements filtrés"
    }
  }
}
