{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SMTP Notifier",
  "type": "object",
  "required": ["smtp_host", "smtp_port", "from_email", "to_emails"],
  "properties": {
    "smtp_host": {"type": "string", "title": "Serveur SMTP", "default": "smtp.gmail.com"},
    "smtp_port": {"type": "integer", "title": "Port SMTP", "default": 587, "minimum": 1, "maximum": 65535},
    "use_tls": {"type": "boolean", "default": true, "title": "Utiliser TLS (STARTTLS)"},
    "username": {"type": "string", "title": "Utilisateur SMTP"},
    "password": {"type": "string", "title": "Mot de passe SMTP", "format": "password"},
    "from_email": {"type": "string", "title": "Adresse expéditeur"},
    "to_emails": {"type": "array", "items": {"type": "string"}, "title": "Destinataires"},
    "event_types": {"type": "array", "items": {"type": "string"}, "default": ["alert.critical", "plate.blacklist"]}
  }
}
