{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StrongSORT",
  "type": "object",
  "properties": {
    "max_age_frames": {
      "type": "integer",
      "default": 30,
      "minimum": 1,
      "title": "Age max avant perte de track"
    },
    "min_hits": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "title": "Hits min pour confirmer un track"
    },
    "iou_threshold": {
      "type": "number",
      "default": 0.3,
      "minimum": 0.0,
      "maximum": 1.0,
      "title": "Seuil IoU association"
    }
  }
}