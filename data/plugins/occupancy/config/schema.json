{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Occupation de zone",
  "type": "object",
  "properties": {
    "zone": {"type": "array", "title": "Polygone de la zone", "default": [[100,100],[500,100],[500,400],[100,400]]},
    "target_labels": {"type": "array", "items": {"type": "string"}, "default": ["person"], "title": "Labels comptés"},
    "max_capacity": {"type": "integer", "default": 10, "minimum": 1, "title": "Capacité max avant alerte"}
  }
}
