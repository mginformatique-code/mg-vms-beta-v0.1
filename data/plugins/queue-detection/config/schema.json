{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Files d'attente",
  "type": "object",
  "properties": {
    "zone": {"type": "array", "title": "Polygone de la zone de file", "default": [[100,100],[500,100],[500,400],[100,400]]},
    "alert_threshold": {"type": "integer", "default": 5, "minimum": 1, "title": "Nombre de personnes avant alerte"},
    "report_interval_s": {"type": "number", "default": 30, "minimum": 5, "title": "Intervalle de rapport (secondes)"}
  }
}
