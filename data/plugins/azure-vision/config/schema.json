{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Azure Computer Vision",
  "type": "object",
  "required": ["endpoint", "subscription_key"],
  "properties": {
    "endpoint": {
      "type": "string",
      "title": "Endpoint",
      "description": "URL de la ressource Cognitive Services (ex: https://mycvvms.cognitiveservices.azure.com)"
    },
    "subscription_key": {
      "type": "string",
      "title": "Subscription Key",
      "description": "Clé Azure Cognitive Services",
      "format": "password"
    },
    "language": {"type": "string", "default": "en", "title": "Langue OCR"},
    "min_confidence": {"type": "number", "default": 0.5, "minimum": 0.0, "maximum": 1.0}
  }
}
