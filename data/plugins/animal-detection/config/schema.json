{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Détection d'animaux",
  "type": "object",
  "properties": {
    "target_labels": {
      "type": "array", "items": {"type": "string"},
      "default": ["bird","cat","dog","horse","sheep","cow","elephant","bear","zebra","giraffe"],
      "title": "Espèces surveillées"
    },
    "min_confidence": {
      "type": "number",
      "default": 0.5,
      "minimum": 0.0,
      "maximum": 1.0,
      "title": "Confiance minimum"
    },
    "cooldown_seconds": {
      "type": "number", "default": 30, "minimum": 1,
      "title": "Anti-répétition (secondes)"
    }
  }
}