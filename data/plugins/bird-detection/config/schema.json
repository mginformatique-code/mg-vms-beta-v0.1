{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Détection d'oiseaux",
  "type": "object",
  "properties": {
    "min_confidence": {
      "type": "number", "default": 0.5, "minimum": 0.0, "maximum": 1.0,
      "title": "Confiance minimum"
    },
    "alert_count": {
      "type": "integer", "default": 1, "minimum": 1,
      "title": "Nombre d'oiseaux avant alerte"
    },
    "cooldown_seconds": {
      "type": "number", "default": 30, "minimum": 1,
      "title": "Anti-répétition (secondes)"
    }
  }
}