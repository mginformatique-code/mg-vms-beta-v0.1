{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Heatmap (zones chaudes)",
  "type": "object",
  "properties": {
    "target_labels": {"type": "array", "items": {"type": "string"}, "default": ["person"], "title": "Labels comptés"},
    "grid_cols": {"type": "integer", "default": 20, "minimum": 2, "title": "Colonnes de la grille"},
    "grid_rows": {"type": "integer", "default": 12, "minimum": 2, "title": "Lignes de la grille"},
    "snapshot_interval_s": {"type": "number", "default": 60, "minimum": 5, "title": "Intervalle d'instantané (secondes)"}
  }
}
