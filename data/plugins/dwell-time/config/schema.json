{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Temps passé (dwell time)",
  "type": "object",
  "properties": {
    "zone": {"type": "array", "title": "Polygone de la zone", "default": [[100,100],[500,100],[500,400],[100,400]]},
    "target_labels": {"type": "array", "items": {"type": "string"}, "default": ["person"], "title": "Labels surveillés"},
    "alert_after_s": {"type": "number", "default": 30, "minimum": 1, "title": "Alerte après (secondes)"}
  }
}
